# Copy this file to .env and fill in real values. Never commit .env.

# Base URL of the FastAPI backend (no trailing slash, no /graphql suffix --
# that's appended by src/lib/apolloClient.ts).
#
# - iOS Simulator / Android Emulator on the same machine as the backend:
#     EXPO_PUBLIC_API_URL=http://localhost:8000
# - Physical device via Expo Go, over the same Wi-Fi network as the backend
#   (see "Mobile dev" in the root README for the backend-side setup):
#     EXPO_PUBLIC_API_URL=http://<your-computer-LAN-IP>:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
